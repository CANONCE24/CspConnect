{
  "name": "cspconnect",
  "version": "1.0.0",
  "private": true,
  "description": "CSPConnect: the CSPC campus feedback and community portal",
  "main": "src/server.js",
  "scripts": {
    "prestart": "node scripts/start-local-db.js --if-configured",
    "start": "node src/server.js",
    "predev": "node scripts/start-local-db.js --if-configured",
    "dev": "nodemon src/server.js",
    "db:start": "node scripts/start-local-db.js",
    "db:setup": "node scripts/setup-db.js",
    "db:setup-hosted": "node scripts/setup-hosted-db.js",
    "db:migrate-auth": "node scripts/migrate-auth.js",
    "admin:provision": "node scripts/provision-admin.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "test:browser": "node scripts/browser-qa.js",
    "test:workflow": "node scripts/workflow-qa.js",
    "db:migrate-emergency": "node scripts/migrate-emergency.js",
    "security:provision": "node scripts/provision-security.js",
    "security:monitor": "node scripts/security-monitor.js",
    "db:migrate-email": "node scripts/migrate-email.js",
    "db:migrate-notifications": "node scripts/migrate-notifications.js",
    "db:migrate-comments": "node scripts/migrate-comment-moderation.js",
    "db:migrate-login": "node scripts/migrate-login.js",
    "email:verify": "node scripts/verify-email.js",
    "db:migrate-affiliation": "node scripts/migrate-affiliation.js",
    "db:migrate-support": "node scripts/migrate-support.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.2.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.0",
    "nodemailer": "^10.1.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "playwright-core": "^1.63.0",
    "smtp-server": "^3.19.23",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "nodemon": {
      "chokidar": "^4.0.3"
    }
  }
}
