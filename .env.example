NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cspc_feedback_db
SESSION_SECRET=
# Production uses Cloudinary; development keeps local images by default.
# Optional override: UPLOAD_STORAGE=local or cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
ADMIN_EMAILS=
# Exact verified email domains for affiliation; all other domains become Visitor.
CSPC_EMAIL_DOMAINS=cspc.edu.ph,my.cspc.edu.ph
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Emergency prototype: security accounts require both provisioning and this allowlist.
SECURITY_EMAILS=
# Leave empty until verified with CSPC. Admin settings override these defaults after saving.
GUARDHOUSE_NUMBER=
GUARDHOUSE_NAME=Guardhouse
GUARDHOUSE_NUMBER_VERIFIED=false
EMERGENCY_ESCALATION_MINUTES=3
# Used only by npm run security:provision, for an existing account.
SECURITY_PROVISION_EMAIL=
# Verification codes, password recovery and feedback emails. Gmail uses an app password.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=CSPConnect Team
# Development-only local SMTP capture servers. Never enable for remote SMTP.
SMTP_ALLOW_INSECURE_LOCAL=false
