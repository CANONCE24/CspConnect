<section class="section flush most-supported">
  <div class="section-heading"><h2>Most supported feedback</h2><a class="text-link" href="/community?sort=most_supported">View in feed</a></div>
  <p class="reaction-note">Support totals for published feedback. Publication and status remain administrator decisions.</p>
  <% const supported = mostSupported.filter(post => Number(post.support_count) > 0); if (supported.length) { %>
    <div class="table-scroll"><table><thead><tr><th scope="col">Feedback title</th><th scope="col">Feedback type</th><th scope="col">Category</th><th scope="col">Support</th><th scope="col">Current status</th></tr></thead><tbody>
      <% supported.forEach(post => { %><tr><td><a class="table-title" href="/admin/feedback/<%= post.id %>"><%= post.title %></a></td><td><span class="type-label type-label--<%= post.type.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>"><%= post.type %></span></td><td><%= post.category_name %></td><td><strong><%= Number(post.support_count) %></strong></td><td><%- include('status',{status:post.status}) %></td></tr><% }); %>
    </tbody></table></div>
  <% } else { %><div class="empty-state"><h3>No supported feedback yet.</h3><p>Published feedback will appear here when students add Support reactions.</p></div><% } %>
</section>
