<form class="filter-bar" method="get" action="<%= action %>">
  <% if (action === '/community') { %><input type="hidden" name="sort" value="<%= query.sort || 'newest' %>"><% } %>
  <% if (action === '/community' && query.status) { %><input type="hidden" name="status" value="<%= query.status %>"><% } %>
  <% if (action === '/community' && query.visibility) { %><input type="hidden" name="visibility" value="<%= query.visibility %>"><% } %>
  <div class="field filter-search"><label for="filter-q">Search</label><input id="filter-q" name="q" type="search" value="<%= query.q || '' %>" maxlength="150" placeholder="Search title or reference"></div>
  <div class="field"><label for="filter-type">Feedback type</label><select id="filter-type" name="type"><option value="">All types</option><% types.forEach(type => { %><option value="<%= type %>"<%= query.type === type ? ' selected' : '' %>><%= type %></option><% }); %></select></div>
  <% if (typeof showStatus !== 'undefined' && showStatus) { %><div class="field"><label for="filter-status">Status</label><select id="filter-status" name="status"><option value="">All statuses</option><% statuses.forEach(status => { %><option value="<%= status %>"<%= query.status === status ? ' selected' : '' %>><%= status %></option><% }); %></select></div><% } %>
  <% if (typeof showCategory !== 'undefined' && showCategory) { %><div class="field filter-category"><label for="filter-category">Category</label><select id="filter-category" name="category"><option value="">All Categories</option><% categories.forEach(category => { %><option value="<%= category.id %>"<%= String(query.category || '') === String(category.id) ? ' selected' : '' %>><%= category.name %></option><% }); %></select></div><% } %>
  <% if (typeof showVisibility !== 'undefined' && showVisibility) { %><div class="field"><label for="filter-visibility">Visibility</label><select id="filter-visibility" name="visibility"><option value="">All feedback</option><option value="published"<%= query.visibility === 'published' ? ' selected' : '' %>>Published</option><option value="private"<%= query.visibility === 'private' ? ' selected' : '' %>>Private</option></select></div><% } %>
  <% if (typeof showAffiliation !== 'undefined' && showAffiliation) { %><div class="field"><label for="filter-affiliation">Affiliation</label><select id="filter-affiliation" name="affiliation"><option value="">All affiliations</option><% ['Student','Faculty','Staff','Visitor'].forEach(value => { %><option value="<%= value %>"<%= query.affiliation === value ? ' selected' : '' %>><%= value %></option><% }); %></select></div><% } %>
  <div class="filter-actions"><button class="button button-primary" type="submit">Apply filters</button><a class="text-link" href="<%= action %>">Reset</a></div>
</form>
