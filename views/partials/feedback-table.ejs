<% if (rows.length) { %>
<div class="table-scroll"><table><thead><tr><th scope="col">Reference / title</th><th scope="col">Type</th><th scope="col">Category</th><th scope="col">Submitted</th><th scope="col">Status</th><th scope="col"><span class="sr-only">Details</span></th></tr></thead><tbody>
<% rows.forEach(item => { %><tr><td><a class="table-title" href="<%= basePath %>/<%= item.id %>"><%= item.title %></a><span class="table-sub"><%= item.reference %></span><% if (user.role === 'admin') { %><span class="table-sub">Affiliation: <%= item.author_affiliation || 'Not set' %></span><% } %></td><td><%= item.type %></td><td><%= item.category_name || 'Uncategorized' %></td><td class="date-cell"><%= formatDate(item.created_at) %></td><td><%- include('status',{status:item.status}) %></td><td><a class="text-link" href="<%= basePath %>/<%= item.id %>" aria-label="View feedback <%= item.reference %>">View</a></td></tr><% }); %>
</tbody></table></div>
<% } else { %><div class="empty-state"><h3><%= typeof emptyTitle !== 'undefined' ? emptyTitle : 'No feedback yet.' %></h3><p><%= typeof emptyMessage !== 'undefined' ? emptyMessage : 'Feedback will appear here when it is submitted.' %></p></div><% } %>
