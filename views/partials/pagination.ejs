<% if (result.total > 0) { const currentPage = Math.max(1, Number(result.page)); const pageCount = Math.max(1, Number(result.pages)); const pageHref = number => { const params = new URLSearchParams(query || {}); params.set('page', String(number)); return '?' + params.toString(); }; %>
<nav class="pagination" aria-label="Pagination"><span><%= result.total %> <%= result.total === 1 ? 'result' : 'results' %> <span class="pagination-page">Page <%= currentPage %> of <%= pageCount %></span></span><div><% if (currentPage > 1) { %><a class="button button-secondary button-small" href="<%= pageHref(currentPage-1) %>">Previous</a><% } %><% if (currentPage < pageCount) { %><a class="button button-secondary button-small" href="<%= pageHref(currentPage+1) %>">Next</a><% } %></div></nav>
<% } %>
