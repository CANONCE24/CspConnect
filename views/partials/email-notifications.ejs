<% const emailErrors = {InvalidRecipient:'Student email is missing or invalid.',EAUTH:'SMTP sign-in failed. Check the server configuration.',DeliveryUnconfirmed:'The send result is unconfirmed. The mail server may already have accepted this message.',RecipientRejected:'The mail server rejected this recipient.',InvalidPayload:'The notification content could not be generated.',InvalidConfiguration:'The email configuration needs attention.'}; %>
<% if (!notificationRows.length) { %><p class="muted">No email notifications yet.</p><% } %>
<div class="email-notification-list"><% notificationRows.forEach(item => { %><article class="email-notification" data-notification-id="<%= item.id %>"><div class="email-notification-heading"><strong><%= ({StatusUpdated:'Feedback update',Acknowledged:'Review update',Resolved:'Resolution',Rejected:'Closure update'})[item.kind] || item.kind %></strong><span class="email-state email-state-<%= item.state.toLowerCase() %>"><%= item.state === 'Sent' ? 'Accepted by mail server' : item.state === 'Processing' ? 'Sending' : item.state === 'Pending' ? 'Queued' : 'Failed' %></span></div>
<% if (typeof showFeedback !== 'undefined' && showFeedback) { %><a class="text-link" href="/admin/feedback/<%= item.feedback_id %>"><%= item.reference %> · <%= item.title %></a><% } %>
<p class="email-recipient"><%= item.recipient || 'No registered email' %> · <%= formatDate(item.created_at) %></p>
<% if (item.state === 'Sent') { %><p class="field-help">Accepted <%= formatDate(item.accepted_at) %>. Inbox delivery has not been confirmed.</p><% } %>
<% if (item.last_error) { %><p class="email-error"><%= emailErrors[item.last_error] || 'The mail server could not complete this attempt.' %><% if (item.state === 'Pending') { %> A retry is queued.<% } %></p><% } %>
<% if (item.attempts?.length) { %><details class="email-attempts"><summary>Attempts (<%= item.attempt_count %>)</summary><ul><% item.attempts.forEach(attempt => { %><li><strong><%= attempt.outcome %></strong> · <%= formatDate(attempt.started_at) %><% if (attempt.error_code) { %> · <%= attempt.error_code %><% } %></li><% }); %></ul></details><% } %>
<% if (item.state === 'Failed' && item.attempt_count < 5) { %><form method="post" action="/admin/notifications/<%= item.id %>/retry" class="email-retry"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if (item.last_error === 'DeliveryUnconfirmed') { %><label class="email-retry-confirm"><input type="checkbox" name="confirmed" value="1" required> I understand this retry may send a duplicate.</label><% } %><button class="button button-small button-secondary" type="submit">Retry email</button></form><% } %>
</article><% }); %></div>
