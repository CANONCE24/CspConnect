<section class="section"><div class="section-heading"><h2>Feedback information</h2><%- include('status',{status:feedback.status}) %></div><dl class="information-grid"><div><dt>Reference number</dt><dd class="reference"><%= feedback.reference %></dd></div><div><dt>Feedback type</dt><dd><%= feedback.type %></dd></div><div><dt>Category</dt><dd><%= feedback.category_name || 'Uncategorized' %></dd></div><div><dt>Submitted</dt><dd><%= formatDate(feedback.created_at) %></dd></div><div><dt>Public identity</dt><dd><%= feedback.is_anonymous ? 'Anonymous' : (feedback.author_name || (user.role === 'student' ? user.name : 'Student')) %></dd></div><% if (user.role === 'admin') { %><div><dt>Submitter affiliation (restricted)</dt><dd><%= feedback.author_affiliation || 'Not set' %></dd></div><div><dt>Submitted by (restricted)</dt><dd><%= feedback.author_name || 'Student' %></dd></div><div><dt>Account email (restricted)</dt><dd><%= feedback.author_email || 'Not available' %></dd></div><% } %><div><dt>Community visibility</dt><dd><%= feedback.is_published ? 'Published in Community Feed' : 'Private submission' %></dd></div></dl></section>
<section class="section"><h2>Description</h2><p class="multiline detail-description"><%= feedback.description %></p></section>
<section class="section"><h2>Attachment</h2><% if (feedback.attachment_url) { %><a class="attachment-link" href="<%= feedback.attachment_url %>" target="_blank" rel="noopener"><img class="attachment-image" src="<%= feedback.attachment_url %>" alt="Image attached to this feedback" loading="lazy"><span>Open attached image</span></a><% } else { %><p class="muted">No image was attached.</p><% } %></section>
<section class="section"><h2>Status history</h2>
  <% if (feedback.history && feedback.history.length) { %><ol class="timeline">
    <% feedback.history.forEach(entry => { %><li>
      <div><strong><%= entry.from_status && entry.from_status === (entry.to_status || entry.status) ? 'Response added' : (entry.to_status || entry.status) %></strong><% if (entry.from_status && entry.from_status !== (entry.to_status || entry.status)) { %><span class="muted"> from <%= entry.from_status %></span><% } %></div>
      <span class="timeline-date"><%= formatDate(entry.created_at) %></span>
      <% if (entry.resolution_summary) { %><div class="feedback-outcome"><strong>Action taken</strong><p class="multiline"><%= entry.resolution_summary %></p></div><% } %>
      <% if (entry.rejection_reason) { %><div class="feedback-outcome"><strong>Reason for closing</strong><p class="multiline"><%= entry.rejection_reason %></p></div><% } %>
      <% if (entry.additional_message) { %><details class="feedback-outcome feedback-history-response"><summary>Message from the administration</summary><p class="multiline"><%= entry.additional_message %></p></details><% } %>
    </li><% }); %>
  </ol><% } else { %><p class="muted">No status changes recorded.</p><% } %>
</section>
<section class="section"><h2>Official responses</h2><p class="section-description">Responses from CSPC administrators about your submission.</p><% if (feedback.responses && feedback.responses.length) { %><div class="response-list"><% feedback.responses.forEach(response => { %><article class="official-response"><div class="response-meta"><strong><%= response.admin_name || 'CSPC Administrator' %></strong><span><%= formatDate(response.created_at) %></span></div><p class="multiline"><%= response.body %></p></article><% }); %></div><% } else { %><p class="muted">No official response yet.</p><% } %></section>
