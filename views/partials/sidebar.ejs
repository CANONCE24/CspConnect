<aside class="sidebar" id="sidebar" aria-label="Primary navigation">
  <a class="brand connect-brand" href="<%= user.role === 'admin' ? '/admin' : user.role === 'security' ? '/security' : '/dashboard' %>" aria-label="CSPConnect home"><%- include('brand') %></a>
  <div class="nav-caption"><%= user.role === 'admin' ? 'ADMINISTRATION' : user.role === 'security' ? 'CAMPUS SECURITY' : 'COMMUNITY PORTAL' %></div>
  <nav class="nav-list">
  <% const navItems = user.role === 'security' ? [['emergency','Emergency Dashboard','/security']] : user.role === 'admin' ? [['dashboard','Dashboard','/admin'],['feedback','Feedback Management','/admin/feedback'],['community','Community Feed','/community'],['comments','Comments','/admin/comments'],['categories','Categories','/admin/categories'],['analytics','Analytics','/admin/analytics'],['contact','Contact Messages','/admin/contact'],['notifications','Email Notifications','/admin/notifications'],['emergency','Emergency Settings','/admin/emergency-settings']] : [['dashboard','Dashboard','/dashboard'],['community','Community Feed','/community'],['submit','Submit Feedback','/feedback/new'],['feedback','My Feedback','/feedback'],['contact','Contact Admin','/contact'],['professor','Professor Assistant','/professor'],['emergency','Emergency','/emergency']]; %>
  <% navItems.forEach(([key,label,url]) => { %><a href="<%= url %>" class="nav-link<%= active === key ? ' is-active' : '' %>"<% if (active === key) { %> aria-current="page"<% } %>><%= label %></a><% }); %>
  </nav>
  <div class="sidebar-bottom"><a class="nav-link sidebar-account<%= active === 'account' ? ' is-active' : '' %>" href="/account"<% if (active === 'account') { %> aria-current="page"<% } %>><%- include('icon',{name:'student'}) %>My account</a><p>Your voice helps improve<br>our campus community.</p><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="signout" type="submit">Sign out</button></form><span class="sidebar-footnote">CSPConnect · Made for our campus</span></div>
</aside>
