<%- include('../partials/head',{publicPage:true,flash:null}) %>
<div class="auth-layout connect-auth">
  <%- include('../partials/auth-intro',{creating:false}) %>
  <section class="connect-auth-form" aria-labelledby="signin-heading">
    <div class="login-panel">
      <h2 id="signin-heading">Sign in</h2>
      <p>Use your Google account or sign in with your email and password.</p>
      <% if (flash && flash.message) { %><div class="notice notice-<%= flash.type === 'error' ? 'error' : 'success' %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>"><%= flash.message %></div><% } %>
      <% if (oauthEnabled) { %><a class="button button-secondary button-full google-button" href="/auth/google"><svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.73-.06-1.42-.19-2.09H12v3.96h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.56c2.08-1.92 3.28-4.75 3.28-7.95Z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.8l-3.56-2.76c-.98.66-2.24 1.06-3.72 1.06-2.87 0-5.3-1.94-6.17-4.54H2.15v2.84A11 11 0 0 0 12 23Z"/><path fill="#FBBC05" d="M5.83 13.96a6.6 6.6 0 0 1 0-3.92V7.2H2.15a11 11 0 0 0 0 9.6l3.68-2.84Z"/><path fill="#EA4335" d="M12 5.5c1.62 0 3.06.56 4.21 1.64l3.16-3.16A10.56 10.56 0 0 0 12 1a11 11 0 0 0-9.85 6.2l3.68 2.84C6.7 7.44 9.13 5.5 12 5.5Z"/></svg>Continue with Google</a><% } else { %><p class="auth-provider-note">Sign in below with your email and password.</p><% } %>
      <% if (oauthEnabled) { %><div class="auth-method-divider"><span>or continue with email</span></div><% } %>
      <form class="password-form" method="post" action="/auth/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label for="login-email">Email address</label><input id="login-email" name="email" type="email" maxlength="254" autocomplete="username" placeholder="you@cspc.edu.ph" required></div>
        <div class="field"><label for="login-password">Password</label><div class="password-input"><input id="login-password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required><button type="button" data-toggle-password="login-password" aria-label="Show password" aria-pressed="false"><%- include('../partials/icon',{name:'eye'}) %></button></div></div>
        <button class="button button-primary button-full signin-button" type="submit">Sign in</button>
      </form>
      <nav class="auth-help-links" aria-label="Sign-in help">
        <a href="/forgot-password">Forgot password?</a>
        <a href="/contact-admin">Need Help? Contact Admin</a>
      </nav>
      <p class="account-switch">Don't have an account? <a href="/signup">Create an account</a></p>
      <div class="auth-trust-note"><span>Your feedback stays private until an administrator publishes it to the Community Feed.</span></div>
    </div>
  </section>
</div>
<%- include('../partials/footer',{publicPage:true}) %>
