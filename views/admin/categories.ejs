<%- include('../partials/head') %>
<header class="page-header"><div><span class="eyebrow">ADMINISTRATION</span><h1>Categories</h1><p>Organize feedback by campus service or area. Inactive categories remain on existing submissions.</p></div></header>
<div class="category-layout"><section class="section flush"><div class="section-heading"><h2>Feedback categories</h2></div><% if (categories.length) { %><div class="table-scroll"><table><thead><tr><th scope="col">Category</th><th scope="col">Name and availability</th></tr></thead><tbody><% categories.forEach(category => { %><tr><td><strong><%= category.name %></strong><span class="table-sub"><%= Number(category.active) !== 0 ? 'Available for submissions' : 'Inactive' %></span></td><td><form class="category-form" method="post" action="/admin/categories"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= category.id %>"><label class="sr-only" for="category-name-<%= category.id %>">Name for <%= category.name %></label><input type="text" name="name" id="category-name-<%= category.id %>" value="<%= category.name %>" maxlength="80" required><label class="sr-only" for="category-active-<%= category.id %>">Availability for <%= category.name %></label><select name="active" id="category-active-<%= category.id %>"><option value="1"<%= Number(category.active) !== 0 ? ' selected' : '' %>>Active</option><option value="0"<%= Number(category.active) === 0 ? ' selected' : '' %>>Inactive</option></select><button type="submit" class="button button-secondary button-small">Save</button></form></td></tr><% }); %></tbody></table></div><% } else { %><div class="empty-state"><h3>No categories yet.</h3><p>Add a category to organize student submissions.</p></div><% } %></section><section class="section"><h2>Add category</h2><form method="post" action="/admin/categories"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="new-category-name">Category name</label><input id="new-category-name" name="name" maxlength="80" required placeholder="For example, Library Services"></div><input type="hidden" name="active" value="1"><button class="button button-primary" type="submit">Add category</button></form><p class="muted note-divider">New categories are available immediately in the submission form.</p></section></div>
<%- include('../partials/footer') %>
