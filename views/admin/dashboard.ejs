<%- include('../partials/head') %>
<header class="page-header"><div><span class="eyebrow">ADMINISTRATION</span><h1>Dashboard</h1><p>Review submissions, monitor progress, and manage the community discussion.</p></div><a class="button button-primary" href="/admin/feedback">Manage Feedback</a></header>
<div class="stats-strip stats-six" aria-label="Feedback summary"><% [['Total Feedback','total'],['Submitted','submitted'],['Under Review','under_review'],['In Progress','in_progress'],['Resolved','resolved'],['Closed','closed']].forEach(([label,key]) => { %><div class="stat"><span class="stat-label"><%= label %></span><strong class="stat-value"><%= Number(stats[key] || 0) %></strong></div><% }); %></div>
<a class="moderation-indicator" href="/admin/comments?view=flagged"><%- include('../partials/icon',{name:'shield'}) %><span>Comments Pending Review</span><strong><%= Number(pendingComments || 0) %></strong><%- include('../partials/icon',{name:'arrow'}) %></a>
<a class="moderation-indicator" href="/admin/contact?status=Open"><%- include('../partials/icon',{name:'comment'}) %><span>Contact Messages</span><strong><%= Number(openSupportTickets || 0) %> Open</strong><%- include('../partials/icon',{name:'arrow'}) %></a>
<section class="section flush"><div class="section-heading"><h2>Recent submissions</h2><a class="text-link" href="/admin/feedback">View all feedback</a></div><%- include('../partials/feedback-table',{rows:recent,basePath:'/admin/feedback',emptyMessage:'Student submissions will appear here.'}) %></section>
<div class="dashboard-grid"><section class="section"><div class="section-heading"><h2>Community Feed moderation</h2><a class="text-link" href="/community">View feed</a></div><% if (community.length) { %><div class="community-list"><% community.forEach(post => { %><article class="feed-entry feed-entry--<%= post.type.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>"><div class="entry-meta"><span class="type-label type-label--<%= post.type.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>"><%= post.type %></span><span><%= post.category_name %></span></div><div class="entry-heading"><h3><a href="/admin/feedback/<%= post.id %>"><%= post.title %></a></h3><%- include('../partials/status',{status:post.status}) %></div><p class="feed-excerpt"><%= String(post.description || '').slice(0,180) %></p><div class="moderation-action"><span>Published <%= formatDate(post.published_at) %></span><a class="text-link" href="/admin/feedback/<%= post.id %>">Review publication</a></div></article><% }); %></div><% } else { %><div class="empty-state"><h3>No published feedback to moderate.</h3><p>Review a submission to approve its community publication.</p></div><% } %></section><section class="section"><div class="section-heading"><h2>Requiring attention</h2><a class="text-link" href="/admin/feedback?status=Submitted">View queue</a></div><% if (attention.length) { %><ul class="attention-list"><% attention.forEach(item => { %><li><a href="/admin/feedback/<%= item.id %>"><%= item.title %></a><span class="table-sub"><%= item.reference %></span><%- include('../partials/status',{status:item.status}) %></li><% }); %></ul><% } else { %><div class="empty-state"><h3>No feedback awaiting review.</h3><p>New submissions will appear here.</p></div><% } %></section></div>
<%- include('../partials/most-supported') %>
<%- include('../partials/footer') %>
