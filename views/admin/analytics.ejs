<%- include('../partials/head') %>
<header class="page-header"><div><span class="eyebrow">ADMINISTRATION</span><h1>Analytics</h1><p>An overview of recorded feedback. Counts reflect current database records.</p></div></header>
<div class="stats-strip stats-six"><% [['Total Feedback','total'],['Submitted','submitted'],['Under Review','under_review'],['In Progress','in_progress'],['Resolved','resolved'],['Closed','closed']].forEach(([label,key]) => { %><div class="stat"><span class="stat-label"><%= label %></span><strong class="stat-value"><%= Number(stats[key] || 0) %></strong></div><% }); %></div>
<div class="analytics-grid"><section class="section"><h2>Feedback by type</h2><% if (stats.byType && stats.byType.length) { %><ul class="breakdown"><% stats.byType.forEach(row => { %><li><span><%= row.name || row.type %></span><strong><%= Number(row.count || row.total || 0) %></strong></li><% }); %></ul><% } else { %><div class="empty-state"><h3>No feedback data yet.</h3><p>Type totals will appear when students submit feedback.</p></div><% } %></section><section class="section"><h2>Feedback by category</h2><% if (stats.byCategory && stats.byCategory.length) { %><ul class="breakdown"><% stats.byCategory.forEach(row => { %><li><span><%= row.name || row.category_name %></span><strong><%= Number(row.count || row.total || 0) %></strong></li><% }); %></ul><% } else { %><div class="empty-state"><h3>No category data yet.</h3><p>Category totals will appear when feedback is recorded.</p></div><% } %></section></div>
<section class="section"><h2>Feedback by affiliation</h2><p class="field-help">Counts reflect each submitter's current affiliation.</p><% if (stats.byAffiliation && stats.byAffiliation.length) { %><ul class="breakdown"><% stats.byAffiliation.forEach(row => { %><li><span><%= row.name %></span><strong><%= Number(row.count) %></strong></li><% }); %></ul><% } else { %><p>No affiliation data yet.</p><% } %></section>
<%- include('../partials/most-supported') %>
<%- include('../partials/footer') %>
