<%- include('../partials/head') %>
<header class="page-header"><div><span class="eyebrow">PRIVATE SUPPORT</span><h1>Contact Administrator</h1><p>Need assistance? Send a private message to the CSPConnect administrator.</p></div></header>
<nav class="moderation-tabs" aria-label="Contact Admin views"><a href="/contact"<%= view==='new'?' aria-current=page':'' %>>New Message</a><a href="/contact?view=conversations"<%= view==='conversations'?' aria-current=page':'' %>>My Conversations</a></nav>
<% if(view==='new'){ %><div class="support-layout"><section class="section">
  <h2>New Message</h2><p class="muted">This conversation is private to you and authorized administrators.</p>
  <% if(formError){ %><div class="notice notice-error" role="alert"><%= formError %></div><% } %>
  <form method="post" action="/contact" data-support-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="request_key" value="<%= requestKey %>">
    <div class="field"><label for="contact-category">Reason for Contact</label><select id="contact-category" name="category" required><option value="">Select a reason</option><% supportCategories.forEach(value=>{ %><option value="<%= value %>"<%= values.category===value?' selected':'' %>><%= value %></option><% }); %></select></div>
    <div class="field"><label for="contact-subject">Subject</label><input id="contact-subject" name="subject" type="text" minlength="3" maxlength="150" value="<%= values.subject || '' %>" required></div>
    <div class="field"><label for="contact-message">Message</label><textarea id="contact-message" name="message" rows="7" maxlength="5000" aria-describedby="contact-message-help" required><%= values.message || '' %></textarea><p id="contact-message-help" class="field-help">Up to 5,000 characters. Never include passwords or sign-in codes.</p></div>
    <button class="button button-primary" type="submit">Send Message</button>
  </form>
</section><aside><%- include('email') %></aside></div>
<% }else{ %><section class="section flush"><%- include('filters',{action:'/contact',admin:false}) %><%- include('tickets',{basePath:'/contact',admin:false,query:{...query,view:'conversations'}}) %></section><%- include('email') %><% } %>
<script src="/js/support.js" defer></script>
<%- include('../partials/footer') %>
