<%- include('../partials/head') %>
<header class="page-header"><div><span class="eyebrow"><%= ticket.reference %> · PRIVATE SUPPORT</span><h1><%= ticket.subject %></h1><p><%= ticket.category %> · Created <%= formatDate(ticket.created_at) %></p></div><a class="button button-secondary" href="<%= admin?'/admin/contact':'/contact?view=conversations' %>">Back to conversations</a></header>
<% if(formError){ %><div class="notice notice-error" role="alert"><%= formError %></div><% } %>
<div class="support-layout"><div>
  <section class="section support-conversation" aria-label="Private conversation">
    <div class="section-heading"><h2>Conversation</h2><%- include('../partials/status',{status:ticket.status}) %></div>
    <% ticket.messages.forEach(message=>{ %><article class="support-message<%= message.sender_role==='admin'?' support-message-admin':'' %>"><div class="support-message-meta"><strong><%= message.sender_name %><%= message.sender_role==='admin'?' · Administrator':'' %></strong><time datetime="<%= new Date(message.created_at).toISOString() %>"><%= formatDate(message.created_at) %></time></div><p class="multiline"><%= message.body %></p></article><% }); %>
  </section>
  <% if(ticket.status!=='Closed'){ %><section class="section"><h2><%= admin?'Reply to user':'Reply to administrator' %></h2><form method="post" action="<%= basePath %>/<%= ticket.id %>/reply" data-support-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="request_key" value="<%= newActionKey() %>"><div class="field"><label for="support-reply">Message</label><textarea id="support-reply" name="message" rows="5" maxlength="5000" required><%= reply %></textarea><p class="field-help">Up to 5,000 characters. <%= admin?'Your reply sets the ticket to Pending.':'Your reply returns the ticket to Open for administrator attention.' %></p></div><button class="button button-primary" type="submit">Send Reply</button></form></section>
  <% }else{ %><section class="section"><h2>Conversation closed</h2><p>Replies are disabled. <%= admin?'Reopen the ticket to continue this conversation.':'If you still need assistance, send a new message or contact the administrator by email.' %></p><% if(!admin){ %><a class="text-link" href="/contact">New Message</a><% } %></section><% } %>
</div><aside>
  <section class="section"><h2>Ticket information</h2><dl class="support-facts"><div><dt>Ticket ID</dt><dd><%= ticket.reference %></dd></div><div><dt>Sender</dt><dd><%= ticket.sender_name %></dd></div><div><dt>Affiliation</dt><dd><%= ticket.affiliation || 'Not set' %></dd></div><% if(admin){ %><div><dt>Email</dt><dd><%= ticket.sender_email %></dd></div><% } %><div><dt>Last updated</dt><dd><%= formatDate(ticket.updated_at) %></dd></div></dl>
    <% if(admin){ %><form method="post" action="/admin/contact/<%= ticket.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="request_key" value="<%= newActionKey() %>"><input type="hidden" name="version" value="<%= ticket.version %>"><div class="field"><label for="ticket-status">Ticket status</label><select id="ticket-status" name="status"><% supportStatuses.forEach(value=>{ %><option value="<%= value %>"<%= ticket.status===value?' selected':'' %>><%= value %></option><% }); %></select></div><button class="button button-secondary" type="submit"><%= ticket.status==='Closed'?'Update / Reopen Ticket':'Update Status' %></button></form><% } %>
  </section>
  <section class="section"><h2>Ticket history</h2><ol class="support-history"><% ticket.history.forEach(entry=>{ const labels={Created:'Ticket opened',AdminReply:'Administrator replied',UserReply:'User replied',StatusChanged:'Status updated'}; %><li><strong><%= labels[entry.action] %></strong><span><%= entry.actor_name %> · <%= entry.status %></span><time datetime="<%= new Date(entry.created_at).toISOString() %>"><%= formatDate(entry.created_at) %></time></li><% }); %></ol></section>
  <% if(!admin){ %><%- include('email') %><% } %>
</aside></div>
<script src="/js/support.js" defer></script>
<%- include('../partials/footer') %>
