<% if(result.items.length){ %><div class="table-scroll"><table class="support-table">
  <thead><tr><th scope="col">Ticket / subject</th><% if(admin){ %><th scope="col">Sender</th><% } %><th scope="col">Reason</th><th scope="col">Status</th><th scope="col">Last updated</th><th scope="col"><span class="sr-only">Conversation</span></th></tr></thead>
  <tbody><% result.items.forEach(ticket=>{ %><tr>
    <td><a class="table-title" href="<%= basePath %>/<%= ticket.id %>"><%= ticket.subject %></a><span class="table-sub"><%= ticket.reference %></span></td>
    <% if(admin){ %><td><%= ticket.sender_name %><span class="table-sub"><%= ticket.affiliation || 'Not set' %></span></td><% } %>
    <td><%= ticket.category %></td><td><%- include('../partials/status',{status:ticket.status}) %></td><td><%= formatDate(ticket.updated_at) %></td>
    <td><a class="text-link" href="<%= basePath %>/<%= ticket.id %>" aria-label="View conversation <%= ticket.reference %>">View conversation</a></td>
  </tr><% }); %></tbody>
</table></div><% }else{ %><div class="empty-state"><h3><%= query.q || query.status?'No conversations match your filters.':'No conversations yet.' %></h3><p><%= admin?'New private support tickets will appear here.':'Send a message to the administrator to start a private conversation.' %></p></div><% } %>
<%- include('../partials/pagination') %>
