<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= subject %></title></head>
<body style="margin:0;padding:24px 12px;background:#f3f6fa;color:#26374b;font-family:Arial,sans-serif;font-size:15px;line-height:1.65">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;margin:0 auto;background:#fff;border:1px solid #e0e6ee;border-radius:12px"><tr><td style="padding:26px 24px;border-bottom:1px solid #e0e6ee"><strong style="font-size:23px;color:#154b91">CSPConnect</strong><br><span style="font-size:12px;color:#63748a">Camarines Sur Polytechnic Colleges</span></td></tr>
<tr><td style="padding:28px 24px;overflow-wrap:anywhere;word-break:break-word"><p style="margin:0 0 10px;color:#154b91;font-size:12px;font-weight:bold;letter-spacing:1px">FEEDBACK <%= kind === 'StatusUpdated' ? status.toUpperCase() : ({Acknowledged:'UNDER REVIEW',Resolved:'RESOLVED',Rejected:'CLOSED'})[kind] %></p><p>Hello <%= name %>,</p>
<% sections.forEach(section => { %><% if (section.label) { %><div style="padding:16px;margin:20px 0;background:#f4f7fb;border-left:3px solid #154b91"><strong><%= section.label %></strong><p style="white-space:pre-line;margin:6px 0 0"><%= section.text %></p></div><% } else { %><p style="margin:18px 0;white-space:pre-line"><%= section.text %></p><% } %><% }); %>
<p style="margin:28px 0 12px"><a href="<%= link %>" style="display:inline-block;background:#154b91;color:#fff;text-decoration:none;border-radius:7px;padding:12px 20px;font-weight:bold">View your submission</a></p><p style="font-size:12px;color:#63748a">Sign in using the account that submitted this feedback.<% if (reference) { %><br>Reference: <%= reference %><% } %></p><p style="margin-top:28px"><strong>CSPConnect Team</strong><br><span style="color:#63748a">Connecting Voices, Creating Change.</span></p></td></tr>
</table></body></html>
