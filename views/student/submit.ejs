<%- include('../partials/head') %>
<header class="page-header"><div><span class="eyebrow">STUDENT PORTAL</span><h1>Submit Feedback</h1><p>Share a suggestion, concern, or appreciation. All submissions are reviewed by an administrator.</p></div></header>
<% if (errors.length) { %><div class="notice notice-error" role="alert"><h2>Please review your submission</h2><ul><% errors.forEach(error => { %><li><%= typeof error === 'string' ? error : error.msg || error.message %></li><% }); %></ul></div><% } %>
<div class="form-layout"><section class="section form-section"><h2 class="form-heading">Feedback details</h2><form method="post" action="/feedback?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field-grid"><div class="field"><label for="type">Feedback type <span class="required">*</span></label><select id="type" name="type" required><option value="">Select a feedback type</option><% types.forEach(type => { %><option value="<%= type %>"<%= values.type === type ? ' selected' : '' %>><%= type %></option><% }); %></select></div><div class="field"><label for="categoryId">Category <span class="required">*</span></label><select id="categoryId" name="categoryId" required><option value="">Select a category</option><% categories.filter(category => Number(category.active) !== 0).forEach(category => { %><option value="<%= category.id %>"<%= String(values.categoryId || '') === String(category.id) ? ' selected' : '' %>><%= category.name %></option><% }); %></select></div></div>
  <div class="field"><label for="feedback-title">Title <span class="required">*</span></label><input id="feedback-title" name="title" maxlength="150" minlength="5" required value="<%= values.title || '' %>" placeholder="A brief, clear summary of your feedback"><p class="field-help">Use 5–150 characters.</p></div>
  <div class="field"><label for="description">Description <span class="required">*</span></label><textarea id="description" name="description" rows="8" minlength="10" maxlength="10000" required placeholder="Describe your feedback. Include relevant details and, where helpful, your suggested solution."><%= values.description || '' %></textarea><div class="field-meta"><span class="field-help">Use 10–10,000 characters. Avoid including sensitive personal information.</span><span class="field-help" data-count-for="description">0 / 10000</span></div></div>
  <div class="field"><label for="attachment">Image attachment <span class="muted">(optional)</span></label><div class="upload-help"><input id="attachment" type="file" name="attachment" accept="image/jpeg,image/png,image/webp"><p class="field-help" id="attachment-name">No image selected.</p></div><p class="field-help">JPG, PNG, or WebP. Maximum file size: 5 MB.</p></div>
  <div class="checkbox-field"><input id="isAnonymous" type="checkbox" name="isAnonymous" value="1"<%= values.isAnonymous ? ' checked' : '' %>><label for="isAnonymous">Submit anonymously<span>Your name will appear as “Anonymous” in the Community Feed. Your account remains linked to the submission for private tracking.</span></label></div>
  <div class="form-actions"><button class="button button-primary" type="submit">Submit Feedback</button><a class="text-link" href="/feedback">Cancel</a></div>
</form></section><aside class="form-notes"><h2>Before you submit</h2><p>Be clear, constructive, and respectful. Provide enough detail for an administrator to understand your feedback.</p><div class="note-divider"><h2>What happens next?</h2><ol><li>Your submission receives a unique reference number.</li><li>An administrator reviews it and updates its status.</li><li>You can track progress and view official responses in My Feedback.</li></ol></div><div class="note-divider"><h2>Your feedback stays private</h2><p>Feedback appears in the Community Feed only after an administrator explicitly approves publication.</p></div></aside></div>
<%- include('../partials/footer') %>
