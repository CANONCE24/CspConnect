<%- include('../partials/head') %>
<header class="page-header"><div><span class="eyebrow">STUDENT PORTAL</span><h1>Welcome, <%= user.name.split(' ')[0] %>.</h1><p>Track your feedback and stay connected with your campus community.</p></div><a class="button button-primary" href="/feedback/new">Submit Feedback</a></header>
<div class="stats-strip" aria-label="Your feedback summary"><div class="stat"><span class="stat-label">My Feedback</span><strong class="stat-value"><%= Number(stats.total || 0) %></strong><span class="stat-note">Total submissions</span></div><div class="stat"><span class="stat-label">Under Review</span><strong class="stat-value"><%= Number(stats.under_review || 0) %></strong><span class="stat-note">Being assessed</span></div><div class="stat"><span class="stat-label">In Progress</span><strong class="stat-value"><%= Number(stats.in_progress || 0) %></strong><span class="stat-note">Action underway</span></div><div class="stat"><span class="stat-label">Resolved</span><strong class="stat-value"><%= Number(stats.resolved || 0) %></strong><span class="stat-note">Completed feedback</span></div></div>
<section class="section flush"><div class="section-heading"><h2>Recent feedback</h2><a class="text-link" href="/feedback">View all feedback</a></div><%- include('../partials/feedback-table',{rows:recent,basePath:'/feedback',emptyMessage:'Your submitted feedback will appear here.'}) %></section>
<div class="dashboard-grid"><section class="section"><div class="section-heading"><h2>Community Feed</h2><a class="text-link" href="/community">View feed</a></div><div class="community-compact"><%- include('../partials/community-list',{posts:community}) %></div></section><div><section class="help-panel"><h2>Have something to share?</h2><p>Whether it is an idea for campus improvements or appreciation for a service, your feedback matters.</p><a class="text-link" href="/feedback/new">Create a submission</a></section><section class="section"><h2>Need help getting started?</h2><p class="muted">Professor can help you understand feedback types, anonymous submissions, and how to track your reference number.</p><a class="text-link" href="/professor">Open Professor Assistant</a></section></div></div>
<%- include('../partials/footer') %>
