<%- include('../partials/head') %>
<a class="back-link" href="/feedback">Back to My Feedback</a><header class="page-header"><div><span class="eyebrow"><%= feedback.reference %></span><h1><%= feedback.title %></h1><p>Track your submission and view updates from the administration.</p></div></header>
<div class="detail-layout"><div><%- include('../partials/detail-content') %></div><aside><section class="section"><h2>Current status</h2><%- include('../partials/status',{status:feedback.status}) %><p class="muted note-divider">Status updates and official responses will appear here as your feedback is reviewed.</p><a class="text-link" href="/feedback">View all my feedback</a></section><section class="form-notes"><h2>Community visibility</h2><p><%= feedback.is_published ? 'This feedback has been approved for the Community Feed.' : 'This feedback remains private. Only an administrator can approve it for community publication.' %></p><% if (feedback.is_published) { %><a class="text-link" href="/community/<%= feedback.id %>">View community discussion</a><% } %></section></aside></div>
<%- include('../partials/footer') %>
