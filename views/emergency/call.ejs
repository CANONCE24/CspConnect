<section class="emergency-call"><span class="emergency-call-icon"><%- include('../partials/icon',{name:'phone'}) %></span><span class="eyebrow">CAMPUS SECURITY</span><h2><%= settings.guardhouse_name || 'Guardhouse' %></h2><p>Need urgent help? Call campus security directly.</p>
<% if (settings.call_number) { %><p class="emergency-phone"><%= settings.call_number %></p><a class="button emergency-button" href="tel:<%= settings.call_number %>"><%- include('../partials/icon',{name:'phone'}) %>CALL GUARDHOUSE</a><p class="emergency-call-help">You can also dial this number manually.</p><% } else { %><button class="button emergency-button" disabled>CALL GUARDHOUSE ? UNAVAILABLE</button><p class="emergency-call-help">Use CSPC's official emergency contact channels.</p><% } %></section>
